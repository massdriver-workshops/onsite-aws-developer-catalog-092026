server {
    listen 8080;
    server_name _;
    root /tmp/www;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location ~ /config\.json$ {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
